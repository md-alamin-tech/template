/* === SUMMARY BLOCK BASE STYLES (MOBILE & GENERAL) === */
.summary-item {
  background: rgba(0, 0, 0, 0.03) !important;
  border-radius: 8px !important;
  padding: 20px !important;
  box-sizing: border-box !important;
  transition: transform 0.4s ease, box-shadow 0.4s ease, background 0.4s ease !important;
}

.summary-item:hover {
  transform: translateY(-6px) !important;
  background: rgba(206, 172, 116, 0.08) !important;
  box-shadow: 
    0 8px 20px rgba(0, 0, 0, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.08) !important;
}

/* === MOBILE STYLES (MAX-WIDTH: 1023PX) === */
@media screen and (max-width: 1023px) {

  .summary-item {
    background: rgba(0, 0, 0, 0.03) !important;
    border-radius: 8px !important;
    padding: 20px !important;
    box-sizing: border-box !important;
    transition: transform 0.4s ease, box-shadow 0.4s ease, background 0.4s ease !important;
  }

  .summary-item:hover {
    transform: translateY(-6px) !important;
    background: rgba(206, 172, 116, 0.08) !important;
    box-shadow: 
      0 4px 10px rgba(0, 0, 0, 0.08),
      0 1px 3px rgba(0, 0, 0, 0.05) !important;
  }

  .summary-thumbnail-container {
    border-radius: 8px !important;
    overflow: hidden !important;
  }

  .summary-thumbnail-container img {
    object-fit: cover !important;
    object-position: center !important;
    transition: transform 0.5s ease !important;
  }

  .summary-item:hover .summary-thumbnail-container img {
    transform: scale(1.05) !important;
  }

  .summary-title {
    font-size: 1.15rem !important;
    font-weight: 600 !important;
    line-height: 1.4 !important;
    margin-bottom: 10px !important;
  }

  .summary-title a {
    color: #1A160F !important;
    transition: color 0.3s ease !important;
  }

  .summary-item:hover .summary-title a {
    color: #CEAC74 !important;
  }

  .summary-excerpt p {
    color: #5C5240 !important;
    font-size: 0.9rem !important;
    line-height: 1.5 !important;
  }

  .summary-metadata-item {
    color: #8B8168 !important;
    font-size: 0.8rem !important;
    margin-top: 10px !important;
  }

}

/* === DESKTOP STYLES (MIN-WIDTH: 1024PX) === */
@media screen and (min-width: 1024px) {

  .summary-block-wrapper,
  .summary-item-list-container {
    overflow: visible !important;
  }

  .summary-item-list {
    display: flex !important;
    gap: 24px !important;
  }

  .summary-item {
    background: rgba(0, 0, 0, 0.02) !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    border-radius: 8px !important;
    padding: 20px !important;
    box-sizing: border-box !important;
    flex: 1 0 auto !important;
    margin: 0 !important;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
  }

  .summary-item:hover {
    transform: translateY(-6px) !important;
    border-color: rgba(206, 172, 116, 0.35) !important;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15) !important;
  }

  .summary-thumbnail-container {
    border-radius: 8px !important;
    overflow: hidden !important;
    margin-bottom: 16px !important;
    width: 100% !important;
    height: 350px !important;
  }

  .summary-thumbnail-container img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    transition: transform 0.5s ease !important;
  }

  .summary-item:hover .summary-thumbnail-container img {
    transform: scale(1.05) !important;
  }

  .summary-title {
    font-size: 1.15rem !important;
    font-weight: 600 !important;
    line-height: 1.4 !important;
    margin-bottom: 10px !important;
  }

  .summary-title a {
    color: #1A160F !important;
    transition: color 0.3s ease !important;
  }

  .summary-item:hover .summary-title a {
    color: #CEAC74 !important;
  }

  .summary-excerpt p {
    color: #5C5240 !important;
    font-size: 0.9rem !important;
    line-height: 1.5 !important;
  }

  .summary-metadata-item {
    color: #8B8168 !important;
    font-size: 0.8rem !important;
    margin-top: 10px !important;
  }

}

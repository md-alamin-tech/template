==========================================================================================
Full website button style
==========================================================================================

#siteWrapper .sqs-button-element--primary,
#siteWrapper .sqs-button-element--secondary,
#siteWrapper .sqs-button-element--tertiary {
  position: relative;
  transition: color 0.3s ease;
}

#siteWrapper .sqs-button-element--primary::before,
#siteWrapper .sqs-button-element--primary::after,
#siteWrapper .sqs-button-element--secondary::before,
#siteWrapper .sqs-button-element--secondary::after,
#siteWrapper .sqs-button-element--tertiary::before,
#siteWrapper .sqs-button-element--tertiary::after {
  content: '';
  position: absolute;
  width: 12px;
  height: 12px;
  transition: all 0.35s ease;
}

#siteWrapper .sqs-button-element--primary::before,
#siteWrapper .sqs-button-element--secondary::before,
#siteWrapper .sqs-button-element--tertiary::before {
  top: 0;
  left: 0;
  border-top: 2px solid #E8B84A;
  border-left: 2px solid #E8B84A;
}

#siteWrapper .sqs-button-element--primary::after,
#siteWrapper .sqs-button-element--secondary::after,
#siteWrapper .sqs-button-element--tertiary::after {
  bottom: 0;
  right: 0;
  border-bottom: 2px solid #E8B84A;
  border-right: 2px solid #E8B84A;
}

#siteWrapper .sqs-button-element--primary:hover,
#siteWrapper .sqs-button-element--secondary:hover,
#siteWrapper .sqs-button-element--tertiary:hover {
  background-color: transparent !important;
  background: transparent !important;

/* ===== GLOBAL BUTTON STYLE — ALL SQUARESPACE BUTTONS ===== */

.sqs-button-element--primary,
.sqs-button-element--secondary,
a.sqs-editable-button,
.sqs-block-button-element {
  border: 1.5px solid rgba(255, 255, 255, 0.7) !important;
  border-radius: 6px !important;
  position: relative !important;
  overflow: hidden !important;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
  z-index: 1;
}

/* Shine/sweep effect on hover */
.sqs-button-element--primary::before,
.sqs-button-element--secondary::before,
a.sqs-editable-button::before,
.sqs-block-button-element::before {
  content: "" !important;
  position: absolute !important;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    120deg,
    transparent,
    rgba(255, 255, 255, 0.35),
    transparent
  ) !important;
  transition: left 0.6s ease !important;
  z-index: -1;
}

.sqs-button-element--primary:hover::before,
.sqs-button-element--secondary:hover::before,
a.sqs-editable-button:hover::before,
.sqs-block-button-element:hover::before {
  left: 100% !important;
}

/* Hover lift + border glow */
.sqs-button-element--primary:hover,
.sqs-button-element--secondary:hover,
a.sqs-editable-button:hover,
.sqs-block-button-element:hover {
  border-color: #ffffff !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2) !important;
}



